    $payloadBody = [ordered]@{ 
        receipt_number = $poValue
        gpu_name = $gpuName
        gpu_brand = $gpuBrand
        gpu_memory_size_mb = $gpuMemSizeInt
        gpu_vbios_version = $gpuVBIOS
        gpu_pcie_gen = $gpuPCIeGen
        gpu_pcie_link_width = $gpuPCIeWidth
        testing_os = $testingOS
        testing_software = $testingSoftware
        testing_user = $testerNameValue
    } 

    $payloadJSON = $payloadBody | ConvertTo-Json -Depth 5

    return $payloadJSON
}


function Convert-XmlNodeToObject {
    param([System.Xml.XmlNode]$node)

    # Handle simple text-only elements (leaf nodes)
    if ($node.NodeType -eq 'Text' -or $node.NodeType -eq 'CDATA') {
        return $node.Value
    }

    $hasAttributes = $node.Attributes -and $node.Attributes.Count -gt 0
    $childElements = $node.ChildNodes | Where-Object { $_.NodeType -eq 'Element' }
    $textNodes = $node.ChildNodes | Where-Object { $_.NodeType -eq 'Text' -or $_.NodeType -eq 'CDATA' }

    # SIMPLE CASE: no attributes, no child elements, just text -> return plain string
    if (-not $hasAttributes -and -not $childElements -and $textNodes) {
        $text = ($textNodes | ForEach-Object { $_.Value }) -join ''
        return $text.Trim()
    }

    # SIMPLE CASE: totally empty element -> return null (or "" if you prefer)
    if (-not $hasAttributes -and -not $childElements -and -not $textNodes) {
        return $null
    }

    $result = [ordered]@{}

    # Include attributes, if any
    if ($hasAttributes) {
        foreach ($attr in $node.Attributes) {
            $result["@$($attr.Name)"] = $attr.Value
        }
    }

    # Group child nodes by name, since XML allows repeated elements
    $childGroups = [ordered]@{}

    foreach ($child in $childElements) {
        $childValue = Convert-XmlNodeToObject -node $child
        if ($childGroups.Contains($child.Name)) {
            if ($childGroups[$child.Name] -isnot [System.Collections.ArrayList]) {
                $existing = $childGroups[$child.Name]
                $childGroups[$child.Name] = [System.Collections.ArrayList]@($existing)
            }
            [void]$childGroups[$child.Name].Add($childValue)
        } else {
            $childGroups[$child.Name] = $childValue
        }
    }

    # If there's mixed content (text alongside child elements), keep #text
    if ($textNodes) {
        $text = (($textNodes | ForEach-Object { $_.Value }) -join '').Trim()
        if ($text) {
            $result["#text"] = $text
        }
    }

    foreach ($key in $childGroups.Keys) {
        $result[$key] = $childGroups[$key]
    }

    return $result
}


