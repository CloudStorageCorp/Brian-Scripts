function Test-GPUInstallation {
    try {
        $gpuInfo = Get-WmiObject Win32_VideoController

        # Remove Intel / Integrated GPU
        $validGPUs = $gpuInfo | Where-Object { 
            $_.Caption -notmatch "Microsoft Basic Display Adapter" -and
            $_.Caption -notmatch "Intel" -and
            $_.Caption -notmatch "UHD" -and
            $_.Caption -notmatch "NVIDIA GeForce GT 710" -and
            $_.Caption -notmatch "NVIDIA Quadro K620"
        }

        if ($validGPUs.Count -eq 0) { return $null }
        return $validGPUs
    }
    catch { return $null }
}

function Run-NvidiaXMLDump {
    $xmlPath = $localxmldir
    $gpu0 = nvidia-smi --query-gpu=name --format=csv,noheader | Select-Object -First 1

    ##Check if the first GPU is a display one that we use
    if ($gpu0 -in $knownDisplayGPUs) {
        nvidia-smi -i 1,2,3 -q -x > $xmlPath
    }
    else {
        nvidia-smi -q -x > $xmlPath
    }

    return $xmlPath
}

function CheckIfECCisEnabled {
    $eccState = nvidia-smi -q | Select-String "Current.*ECC"
    return ($eccState -match "Enabled")
}

function EnableECC {
    return (nvidia-smi -e 1 2>&1)
}

function Restart-Now {
    $confirm = [System.Windows.Forms.MessageBox]::Show(
        "Are you sure you want to restart the computer now?", 
        "Confirm Restart", 
        [System.Windows.Forms.MessageBoxButtons]::YesNo,
        [System.Windows.Forms.MessageBoxIcon]::Warning
    )
    if ($confirm -eq [System.Windows.Forms.DialogResult]::Yes) {
        shutdown /r /t 0
    }
}

function CheckHeadless {
    [xml]$xmlContents = Get-Content $localxmldir
    $isHeadless = $xmlContents.nvidia_smi_log.gpu.driver_model.current_dm

    if ($isHeadless -eq 'TCC'){
        return $true
    }

    if ($isHeadless -eq 'WDDM'){
        return $false
    }
}

